{
    "name": "medassist-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup src/server.ts --format esm --target node22 --clean",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
        "dev:memory": "tsx src/dev-memory.ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "argon2": "^0.45.1",
        "cors": "^2.8.6",
        "dotenv": "^18.0.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.4.0",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "sharp": "^0.35.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.4.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.20.4",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "pglite-prisma-adapter": "^0.7.2",
        "prisma": "^7.10.0",
        "supertest": "^7.3.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}
