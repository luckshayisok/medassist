generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  CAREGIVER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  /// Always stored lower-cased and trimmed.
  email        String   @unique @db.VarChar(254)
  passwordHash String
  role         Role
  /// IANA timezone, e.g. "Asia/Kolkata". Schedules are wall-clock times in this zone.
  timezone     String   @default("UTC") @db.VarChar(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  patientProfile      PatientProfile?
  refreshTokens       RefreshToken[]
  caregiverOf         CaregiverRelationship[] @relation("caregiver")
  caregivers          CaregiverRelationship[] @relation("patient")
  medications         Medication[]
  prescriptions       Prescription[]
  medicationLogs      MedicationLog[]          @relation("patientLogs")
  loggedMedicationLog MedicationLog[]          @relation("loggedBy")
  chatMessages        ChatMessage[]
  pushTokens          PushToken[]
}

model PatientProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @db.Uuid
  dateOfBirth           DateTime? @db.Date
  preferences           Json      @default("{}")
  accessibilitySettings Json      @default("{}")
  emergencyContactName  String?   @db.VarChar(100)
  emergencyContactPhone String?   @db.VarChar(32)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Opaque refresh tokens, stored hashed. Rotated on every use; reuse revokes the family.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  familyId   String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

model CaregiverRelationship {
  id          String             @id @default(uuid()) @db.Uuid
  caregiverId String             @db.Uuid
  patientId   String             @db.Uuid
  status      RelationshipStatus @default(PENDING)
  /// e.g. ["view_adherence","manage_medications","verify_prescriptions","receive_alerts"]
  permissions String[]
  inviteCode  String?            @unique @db.VarChar(16)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  caregiver User @relation("caregiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  patient   User @relation("patient", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, patientId])
  @@index([patientId, status])
}

// ─── Medication plan ─────────────────────────────────────────────────────────

enum FoodTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  EMPTY_STOMACH
  ANY
}

enum Frequency {
  DAILY
  SPECIFIC_DAYS
  EVERY_N_DAYS
}

model Medication {
  id                String     @id @default(uuid()) @db.Uuid
  patientId         String     @db.Uuid
  name              String     @db.VarChar(120)
  dosage            String     @db.VarChar(60)
  doseQuantity      Decimal    @default(1) @db.Decimal(6, 2)
  unit              String     @db.VarChar(20)
  imageKey          String?
  instructions      String?    @db.VarChar(1000)
  foodTiming        FoodTiming @default(ANY)
  foodInstructions  String?    @db.VarChar(500)
  /// [{ text, sourceKind, source, url }] — only sourced entries are displayed.
  avoidInstructions Json       @default("[]")
  precautions       String?    @db.VarChar(1000)
  startDate         DateTime   @db.Date
  endDate           DateTime?  @db.Date
  prescriber        String?    @db.VarChar(120)
  notes             String?    @db.VarChar(2000)
  prescriptionMedId String?    @unique @db.Uuid
  active            Boolean    @default(true)
  deletedAt         DateTime?  @db.Timestamptz(3)
  /// Optimistic concurrency for offline edits.
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)

  patient              User                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  schedules            MedicationSchedule[]
  logs                 MedicationLog[]
  prescriptionMedication PrescriptionMedication? @relation(fields: [prescriptionMedId], references: [id], onDelete: SetNull)

  @@index([patientId, active])
}

model MedicationSchedule {
  id           String    @id @default(uuid()) @db.Uuid
  medicationId String    @db.Uuid
  /// Wall-clock "HH:mm" in the patient's timezone.
  time         String    @db.Char(5)
  frequency    Frequency @default(DAILY)
  /// 0 = Sunday … 6 = Saturday
  daysOfWeek   Int[]
  intervalDays Int?
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  /// Set when a time is removed from the plan. Archived (not deleted) so dose history is kept.
  archivedAt   DateTime? @db.Timestamptz(3)

  medication Medication      @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  logs       MedicationLog[]

  @@index([medicationId])
}

// ─── Adherence ───────────────────────────────────────────────────────────────

enum DoseLogStatus {
  TAKEN
  SKIPPED
  SNOOZED
  MISSED
}

model MedicationLog {
  id           String        @id @default(uuid()) @db.Uuid
  /// Client-generated id → idempotent offline sync.
  clientId     String        @unique @db.Uuid
  medicationId String        @db.Uuid
  scheduleId   String        @db.Uuid
  patientId    String        @db.Uuid
  scheduledFor DateTime      @db.Timestamptz(3)
  takenAt      DateTime?     @db.Timestamptz(3)
  status       DoseLogStatus
  skipReason   String?       @db.VarChar(32)
  skipNote     String?       @db.VarChar(500)
  snoozedUntil DateTime?     @db.Timestamptz(3)
  loggedById   String        @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  medication Medication         @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  patient    User               @relation("patientLogs", fields: [patientId], references: [id], onDelete: Cascade)
  loggedBy   User               @relation("loggedBy", fields: [loggedById], references: [id])

  /// One outcome per scheduled dose.
  @@unique([scheduleId, scheduledFor])
  @@index([patientId, scheduledFor])
}

// ─── Prescriptions ───────────────────────────────────────────────────────────

enum PrescriptionStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  VERIFIED
  FAILED
}

model Prescription {
  id           String             @id @default(uuid()) @db.Uuid
  patientId    String             @db.Uuid
  imageKey     String
  ocrText      String?
  status       PrescriptionStatus @default(UPLOADED)
  errorMessage String?
  verifiedById String?            @db.Uuid
  verifiedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  patient     User                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medications PrescriptionMedication[]

  @@index([patientId, createdAt])
}

model PrescriptionMedication {
  id               String  @id @default(uuid()) @db.Uuid
  prescriptionId   String  @db.Uuid
  name             String? @db.VarChar(120)
  dosage           String? @db.VarChar(60)
  frequency        String? @db.VarChar(120)
  timing           String? @db.VarChar(120)
  foodInstructions String? @db.VarChar(500)
  duration         String? @db.VarChar(120)
  doctorNotes      String? @db.VarChar(1000)
  sourceText       String? @db.VarChar(1000)
  /// 0–1 overall confidence from the extractor.
  confidence       Float   @default(0)
  /// Field names the model could not read clearly. Never auto-filled.
  unclearFields    String[]
  verified         Boolean @default(false)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?

  @@index([prescriptionId])
}

// ─── Assistant ───────────────────────────────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  conversationId String   @db.Uuid
  role           ChatRole
  message        String   @db.VarChar(8000)
  /// [{ kind: "prescription"|"verified"|"general"|"ai", source?, url? }]
  citations      Json     @default("[]")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

// ─── File storage ────────────────────────────────────────────────────────────

/// Private files (medicine/prescription photos) when STORAGE_DRIVER=db — for hosts without a
/// persistent disk (e.g. Render free). Photos are re-encoded to ~100–200 KB, so this stays small.
model StoredFile {
  key         String   @id @db.VarChar(64)
  data        Bytes
  contentType String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

// ─── Devices ─────────────────────────────────────────────────────────────────

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
