# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Local Postgres 18. Create the DB first:  createdb -U postgres medassist
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/medassist

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed by CORS (mobile apps don't send Origin; this is for web tools).
CORS_ORIGINS=http://localhost:8081

# Private uploads folder (dev). Use S3/R2 in production.
STORAGE_DIR=./uploads
# 'db' stores photos in Postgres (needed on Render free, which has no persistent disk)
STORAGE_DRIVER=local
